# Gitignore for Product Sourcing Intelligence Agent

# Python / FastAPI
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
*.so
.env # Environment variables

# Temporary files created by the application
/tmp/

# Next.js / Node.js
node_modules/
.next/ # Next.js build output
out/   # Next.js static export output
.turbo/ # Turborepo cache (if used)

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editor/IDE files
.idea/ # IntelliJ IDEA
.vscode/ # VS Code
.sublime-workspace # Sublime Text

# OS generated files
.DS_Store # macOS
.Trashes # macOS
ehthumbs.db # Windows
Thumbs.db # Windows
