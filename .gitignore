# Gitignore for Product Sourcing Intelligence Agent
# NOTE: git only treats '#' as a comment at the start of a line.
# Keep comments on their own lines — trailing comments become part of the pattern.

# Python / FastAPI
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
*.so
.pytest_cache/
.mypy_cache/

# Environment variables
.env
.env.local
.env.*.local

# Temporary files created by the application
/tmp/

# Next.js / Node.js
node_modules/
# Next.js build output
.next/
# Next.js static export output
out/
# Turborepo cache (if used)
.turbo/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editor/IDE files
.idea/
.vscode/
*.sublime-workspace

# OS generated files
.DS_Store
.Trashes
ehthumbs.db
Thumbs.db
