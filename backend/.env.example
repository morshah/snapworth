# Copy to backend/.env and fill in your keys. Never commit the real .env.

# Reverse image search — https://serpapi.com (Google Lens engine)
SERPAPI_API_KEY=

# Image hosting for the reverse search — https://api.imgbb.com/ (free API key)
IMGBB_API_KEY=

# Report generation — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Auth — secret used to sign login JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Database — leave unset to use a local SQLite file for development.
# For production, set your Postgres URL (Neon/Supabase), e.g.:
#   DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# DATABASE_URL=

# Rate limiting (optional). In-memory by default; set a shared backend
# (e.g. redis://localhost:6379) if you run multiple backend instances.
# RATE_LIMIT_STORAGE_URI=
# LOGIN_RATE_LIMIT=5/minute
# UPLOAD_RATE_LIMIT=10/hour

# Pipeline thresholds (optional; defaults shown)
# MAX_FOUND_SITES=30          # how many found sites to record/show
# MAX_LISTINGS=5              # how many sites to actually visit & scrape
# MAX_IMAGES=12               # how many images to aggregate into a report
# SCRAPE_TIMEOUT_SECONDS=8    # per-site scrape timeout

# Optional overrides (defaults shown)
# JWT_EXPIRE_MINUTES=60
# INVITE_EXPIRE_DAYS=7
# CLAUDE_MODEL=claude-opus-4-8
# MAX_LISTINGS=5
# MAX_IMAGES=12
# SCRAPE_TIMEOUT_SECONDS=8
